{
  "$schema": "https://schema.tauri.app/config/2.11.2",
  "productName": "DDNet Manager",
  "version": "0.1.0",
  "identifier": "com.ddnet.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DDNet Manager",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "fullscreen": false,
        "visible": true
      },
      {
        "label": "tray-menu",
        "title": "",
        "url": "tray-menu.html",
        "width": 180,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focusable": true,
        "shadow": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 https://ddnet.org https://*.ddnet.org; font-src 'self' data:; media-src 'self' asset: https://asset.localhost data: blob:",
      "devCsp": null,
      "capabilities": [
        {
          "identifier": "main-window-core",
          "description": "Core permissions for the primary DDNet Manager launcher window.",
          "windows": [
            "main",
            "tray-menu"
          ],
          "permissions": [
            "core:default",
            "core:app:default",
            "core:event:default",
            "core:event:allow-emit",
            "core:webview:default",
            "core:window:default",
            "core:window:allow-close",
            "core:window:allow-minimize",
            "core:window:allow-start-dragging",
            "core:window:allow-show",
            "core:window:allow-set-focus",
            "core:window:allow-hide",
            "dialog:allow-open",
            "updater:default",
            "process:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "DDNet third-party launcher.",
    "longDescription": "A candy-styled DDNet manager for validating local third-party client directories, managing updates and launching verified client executables.",
    "copyright": "Copyright 2026 DDNet Manager Team",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/wuqie-xuanzhao/DDNet-Manager/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOEE2OEFCMEE1MkUxMDkKUldRSjRWSUtxMmlLd0RYbkZqRno5VXpjYllURk1qUDA2czVyZnBvYW5yQ2QxME9JakRrK05SNTcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
